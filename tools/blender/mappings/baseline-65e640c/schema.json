{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format",
    "camera",
    "materials",
    "meshFiles",
    "proxyMeshes",
    "interactionProxies"
  ],
  "properties": {
    "meshFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "materialId",
          "vertices",
          "triangles"
        ]
      }
    },
    "camera": {
      "type": "object",
      "required": [
        "position",
        "forward",
        "up",
        "right",
        "projection",
        "verticalFovDegrees",
        "horizontalFovDegrees"
      ]
    }
  }
}